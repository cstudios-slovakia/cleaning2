{
    "name": "cstudios-slovakia/cleaner",
    "description": "PWA for cleaning management",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Cstudios s.r.o.",
            "email": "fron@cstudios.sk"
        }
    ],
    "require": {
        "php": ">=8.0",
        "minishlink/web-push": "^10.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-create-project-cmd": [
            "echo \"Cstudios Cleaning System installed. Please run 'npm install' and 'npm run build' in the frontend directory, then access the app to run the setup wizard.\""
        ]
    }
}